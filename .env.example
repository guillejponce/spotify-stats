# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify — Developer Dashboard app
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Redirect URI MUST match Spotify Dashboard exactly (scheme, host, port, path, no trailing slash).
#
# Spotify (2025+): redirect URIs with hostname "localhost" are rejected ("Insecure redirect URI").
# For local dev use the loopback IP with HTTP — see:
# https://developer.spotify.com/documentation/web-api/tutorials/migration-insecure-redirect-uri
#
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Open the site in the browser at the SAME URL as NEXT_PUBLIC_APP_URL (127.0.0.1, not "localhost")

# Site lock (personal use). If unset, the app stays open.
# Cookie lasts ~400 days so the iPhone/Mac PWA does not ask again.
# Change this value to invalidate every device.
SITE_PASSWORD=

# Cron: pg_cron (Supabase) llama GET /api/cron/ranking-alerts y /api/cron/kurt
# con Authorization: Bearer <CRON_SECRET>. Ver supabase/*_cron.sql
# Vercel Hobby no corre crons horarios; no uses vercel.json para Kurt.
CRON_SECRET=

# Web Push (VAPID). Generate with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# OpenAI API (platform.openai.com) — NOT ChatGPT Plus.
# Used by /agent. Keep this out of git; put the real key in .env.local
OPENAI_API_KEY=

# Optional TTS voice: alloy | ash | coral | echo | fable | nova | onyx | sage | shimmer | verse
OPENAI_TTS_VOICE=nova
