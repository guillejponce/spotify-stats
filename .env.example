# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Spotify — Developer Dashboard app. Login goes through Supabase Auth:
#   1. Supabase → Authentication → Providers → Spotify: same CLIENT_ID + SECRET.
#   2. Spotify Dashboard → Redirect URIs: https://<project>.supabase.co/auth/v1/callback
#   3. Supabase → Authentication → URL Configuration → Redirect URLs:
#      <NEXT_PUBLIC_APP_URL>/auth/callback (prod and http://127.0.0.1:3000/auth/callback)
# The app keeps CLIENT_ID + SECRET to refresh each user's Spotify token.
# Spotify apps in "Development mode" only accept users added under "User Management".
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Accounts are invite-only. The admin email is set in supabase/multiuser/001_tenancy.sql
# (app_config.admin_email); it must be the email of the admin's Spotify account.

# Cron: pg_cron (Supabase) llama GET /api/cron/ranking-alerts y /api/cron/kurt
# con Authorization: Bearer <CRON_SECRET>. Ver supabase/*_cron.sql
# Vercel Hobby no corre crons horarios; no uses vercel.json para Kurt.
# Plays: el job existente POST a /functions/v1/sync-plays (no hace falta otro cron).
CRON_SECRET=

# Web Push (VAPID). Generate with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# OpenAI API (platform.openai.com) — NOT ChatGPT Plus.
# Used by /agent. Keep this out of git; put the real key in .env.local
OPENAI_API_KEY=

# Optional TTS voice: alloy | ash | coral | echo | fable | nova | onyx | sage | shimmer | verse
OPENAI_TTS_VOICE=nova
